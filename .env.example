# ═══════════════════════════════════════════════════════════════════
# CHEF IA STUDIO — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preench os valores com suas chaves reais
# 3. NUNCA commite .env para git (já está em .gitignore)
# 4. Variáveis comentadas (#) são opcionais/futuras
#
# ═══════════════════════════════════════════════════════════════════

# SERVIDOR
PORT=3000

# Acesso temporario para teste externo.
# Se preencher, o backend exige esta senha em /gerar-cardapio.
# Deixe vazio/remova para uso local sem senha.
DEMO_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────
# PROVIDERS DE IA (OBRIGATÓRIO: escolha um)
# ─────────────────────────────────────────────────────────────────

# Google Gemini (RECOMENDADO AGORA)
# Obtenha em: https://ai.google.dev/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-flash-lite-latest

# Google Generative AI (LEGADO - será descontinuado)
# Compatibilidade com versão antiga
GOOGLE_API_KEY=sua_chave_google_aqui

# Seleção de provider principal
AI_PROVIDER=gemini

# Referencias externas opcionais e transitorias.
# Gere uma chave nova em https://spoonacular.com/food-api/console#Profile
# Nao reutilize chaves compartilhadas em chats e nunca commite o .env.
# O Chef IA nao salva ingredientes ou instrucoes retornados pelo Spoonacular.
SPOONACULAR_API_KEY=
SPOONACULAR_DAILY_SEARCH_LIMIT=5

# ─────────────────────────────────────────────────────────────────
# PROVIDERS ALTERNATIVOS (OPCIONAIS - para futuro)
# ─────────────────────────────────────────────────────────────────

# OpenAI
# OPENAI_API_KEY=sua_chave_openai_aqui

# OpenRouter (Gateway Multi-modelo)
# OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# ─────────────────────────────────────────────────────────────────
# IMAGENS (OPCIONAIS - para futuro)
# ─────────────────────────────────────────────────────────────────

# Unsplash (Imagens editoriais)
# UNSPLASH_ACCESS_KEY=sua_chave_unsplash_aqui

# Pexels (Imagens livres)
# PEXELS_API_KEY=sua_chave_pexels_aqui

# Openverse funciona anonimamente e nao exige chave.
OPENVERSE_DAILY_SEARCH_LIMIT=40

# ─────────────────────────────────────────────────────────────────
# E-MAIL (OPCIONAIS - para futuro)
# ─────────────────────────────────────────────────────────────────

# EmailJS (para enviar relatórios)
# EMAILJS_PUBLIC_KEY=sua_chave_publica_aqui
# EMAILJS_SERVICE_ID=seu_service_id_aqui
# EMAILJS_TEMPLATE_ID=seu_template_id_aqui

# ─────────────────────────────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────────────────────────────

# Supabase (Plano 14: banco, autenticacao e storage de fotos dos usuarios).
# OBRIGATORIO para contas/fornecedores/fotos; a geracao de cardapio funciona
# sem isso, mas login e personalizacao ficam desativados.
# Painel do projeto -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave com privilegio total (bypassa RLS). Uso restrito ao backend, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Chave mestra para cifrar (AES-256-GCM) a chave Gemini que cada usuario cola
# no proprio perfil (Plano 16, item 2). OBRIGATORIA para essa funcionalidade;
# sem ela, o app funciona normalmente com a chave compartilhada. Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Nunca trocar em producao com chaves ja salvas: quem ja tiver configurado a
# propria chave Gemini nao conseguira mais decifra-la.
CHAVE_IA_ENCRYPTION_SECRET=

# Firebase (nao usado - projeto migrou para Supabase no Plano 14; mantido comentado
# apenas como registro historico da decisao)
# FIREBASE_API_KEY=sua_chave_aqui
# FIREBASE_AUTH_DOMAIN=seu_dominio_aqui
# FIREBASE_PROJECT_ID=seu_projeto_aqui
# FIREBASE_STORAGE_BUCKET=seu_bucket_aqui
# FIREBASE_MESSAGING_SENDER_ID=seu_id_aqui
# FIREBASE_APP_ID=seu_app_id_aqui

# ═══════════════════════════════════════════════════════════════════
# FIM DO ARQUIVO .env.example
# ═══════════════════════════════════════════════════════════════════
#
# COMO OBTER AS CHAVES:
#
# 1. GEMINI_API_KEY
#    → Acesse: https://ai.google.dev/
#    → Clique "Get API Key"
#    → Copie a chave
#
# 2. OPENAI_API_KEY (opcional)
#    → Acesse: https://platform.openai.com/
#    → API Keys → Create new secret key
#    → Copie a chave
#
# 3. PEXELS_API_KEY (opcional)
#    → Acesse: https://www.pexels.com/api/
#    → Clique "Request API Access"
#    → Copie a chave
#
# 4. SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (Plano 14)
#    → Acesse: https://supabase.com/ e crie um projeto gratuito
#    → No projeto: Project Settings → API
#    → Copie "Project URL", a chave "anon public" e a chave "service_role"
#
# ═══════════════════════════════════════════════════════════════════
